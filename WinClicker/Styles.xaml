<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinClicker">
    <Style
        x:Key="InfoButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <!--
            Based on the font size of the font icon (14 epx).
            Therefore halving it equals 7 epx.
            Rounding up for subpixel rendering cases.
        -->
        <Setter Property="CornerRadius" Value="8" />
    </Style>
</ResourceDictionary>
